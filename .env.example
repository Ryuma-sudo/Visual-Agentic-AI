GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional. Keep tracing off while developing with a tight daily Gemini quota.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Visual-Agent

# Gemini free-tier friendly default.
GEMINI_MODEL=gemini-2.5-flash-lite

# Use yolo11n.pt for faster/lighter local tests, or yolo11x.pt to match the PDF.
YOLO_MODEL=models/yolo11n.pt

